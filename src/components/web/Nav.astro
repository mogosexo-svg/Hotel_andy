---
interface Props { nombre: string; inicio?: boolean }
const { nombre, inicio = true } = Astro.props;
const base = inicio ? '' : '/';
---
<header class="nav">
  <div class="container nav-fila">
    <a class="marca" href="/" aria-label={`${nombre}, inicio`}>
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M2 20c4-4 8-4 12 0s8 4 12 0 4-3 4-3v5c0 0-1 1-4 3-4 3-8 3-12 0s-8-3-12 0Z" fill="var(--color-accent)"/><path d="M2 12c4-4 8-4 12 0s8 4 12 0 4-3 4-3" fill="none" stroke="var(--color-shade-2)" stroke-width="2.5" stroke-linecap="round"/></svg>
      <span>{nombre}</span>
    </a>
    <nav class="nav-enlaces" aria-label="Principal">
      <a href={`${base}#habitaciones`}>Habitaciones</a>
      <a href={`${base}#piscina`}>Piscina</a>
      <a href={`${base}#practico`}>Lo práctico</a>
      <a href={`${base}#donde`}>Cómo llegar</a>
      <a href={`${base}#preguntas`}>Preguntas</a>
    </nav>
    <a class="btn btn-nav" href={`${base}#reservar`}>Reservar</a>
  </div>
</header>
