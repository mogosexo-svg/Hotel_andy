---
interface Props { nombre: string; inicio?: boolean }
const { nombre, inicio = true } = Astro.props;
const base = inicio ? '' : '/';
---
<header class="nav vidrio vidrio-claro">
  <a class="marca" href="/" aria-label={`${nombre}, inicio`}>
    <svg viewBox="0 0 32 20" width="30" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 7c4-4 8-4 12 0s8 4 12 0 3-2.5 4-2M2 14c4-4 8-4 12 0s8 4 12 0 3-2.5 4-2"/></svg>
    <span>{nombre}</span>
  </a>
  <nav class="nav-enlaces" aria-label="Principal">
    <a href={`${base}#habitaciones`}>Habitaciones</a>
    <a href={`${base}#piscina`}>Piscina</a>
    <a href={`${base}#resenas`}>Reseñas</a>
    <a href={`${base}#donde`}>Cómo llegar</a>
    <a href={`${base}#preguntas`}>Preguntas</a>
  </nav>
  <a class="btn btn-nav" href={`${base}#reservar`}><span>Reservar</span></a>
</header>
