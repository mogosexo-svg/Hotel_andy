---
import Foto from './Foto.astro';
import { hora, type Catalogo } from './catalogo';
interface Props { c: Catalogo }
const { c } = Astro.props;
const r = c.hotel.reglas;
const filas: [string, string][] = [
  ['Entrada', `Desde las ${hora(c.hotel.check_in)}`],
  ['Salida', `Hasta las ${hora(c.hotel.check_out)}`],
  r.ascensor === false ? ['Ascensor', 'No hay, se sube por escaleras'] : null,
  r.parqueadero != null ? ['Parqueadero', r.parqueadero ? 'Sí' : 'No'] : null,
  r.mascotas?.aceptadas ? ['Mascotas', r.mascotas.cargo_adicional == null ? 'Aceptadas con cargo, consulta el valor por WhatsApp' : 'Aceptadas con cargo'] : null,
  r.desayuno != null ? ['Desayuno', r.desayuno ? 'Incluido' : 'No incluido'] : null,
  r.anticipo ? ['Para confirmar', `Anticipo del ${r.anticipo.porcentaje} % por ${r.anticipo.medio}`] : null,
].filter((x): x is [string, string] => !!x);
---
<section id="practico" class="seccion practico">
  <div class="container practico-grid">
    <div class="practico-fotos reveal">
      <Foto nombre="terraza-2" widths={[360, 540, 900]} sizes="(min-width: 960px) 300px, 60vw" />
      <Foto nombre="terraza-3" widths={[360, 540, 900]} sizes="(min-width: 960px) 300px, 60vw" />
    </div>
    <div class="reveal">
      <h2>Lo práctico, antes de reservar</h2>
      <p class="lead">La terraza con vista al mar es de todos los huéspedes. Esto es lo que conviene saber.</p>
      <dl class="reglas">
        {filas.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </div>
</section>
