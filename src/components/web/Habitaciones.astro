---
import { Picture } from 'astro:assets';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { foto, fotosDeTipo } from './fotos';
import { titulo } from './serif';
import { dinero, hora, type Catalogo } from './catalogo';
interface Props { c: Catalogo }
const { c } = Astro.props;
const r = c.hotel.reglas;
const incluye: [string, string][] = [
  ['reloj', `Entrada desde las ${hora(c.hotel.check_in)}, salida hasta las ${hora(c.hotel.check_out)}`],
  r.piscina ? ['ola', `Piscina de ${hora(r.piscina.abre)} a ${hora(r.piscina.cierra)}`] : null,
  r.parqueadero ? ['auto', 'Parqueadero'] : null,
  r.ascensor === false ? ['escalera', 'Sin ascensor, se sube por escaleras'] : null,
  r.desayuno === false ? ['taza', 'Desayuno no incluido'] : null,
  r.mascotas?.aceptadas ? ['perro', 'Mascotas con cargo adicional'] : null,
].filter((x): x is [string, string] => !!x);
const spans = ['s7', 's5', 's4', 's4', 's4', 's5', 's7'];
---
<section id="habitaciones" class="cuartos-sec">
  <div class="cab">
    <p class="etiqueta rv">Habitaciones</p>
    <h2 class="gigante rv" set:html={titulo('Elige tu *cuarto*')} />
    <p class="lead rv">{c.tipos.length} tipos, para dos personas o para toda la familia. El precio es por habitación, no por persona.</p>
  </div>
  <ul class="cuartos">
    {c.tipos.map((t, i) => {
      const fs = fotosDeTipo(t.clave);
      return (
        <li class={`cuarto ${spans[i % spans.length]} rv`}>
          <button type="button" class="cuarto-btn" data-visor aria-haspopup="dialog" aria-label={`Ver fotos de ${t.nombre}`}>
            {fs.length ? (
              <Foto nombre={fs[0]} class="cuarto-foto" widths={[400, 700, 1000]} sizes="(min-width: 900px) 45vw, 92vw" />
            ) : (
              <div class="cuarto-foto cuarto-sin"><Icono n="ola" tam={40} /><span>Foto próximamente</span></div>
            )}
            <span class="cuarto-cap vidrio">
              <span class="cuarto-nombre">{t.nombre}</span>
              <span class="cuarto-meta">Hasta {t.max_personas} personas{fs.length > 1 ? `, ${fs.length} fotos` : ''}</span>
              {t.desde_centavos != null && <span class="cuarto-precio">Desde <strong class="num">{dinero(t.desde_centavos)}</strong></span>}
            </span>
          </button>
          <template>
            <div class="v-slides" data-n={fs.length}>
              {fs.length ? fs.map((n, k) => {
                const { img, alt } = foto(n);
                return (
                  <figure class="v-slide" data-activa={k === 0 ? '' : undefined}>
                    <Picture src={img} alt="" formats={['avif', 'webp']} widths={[480, 900]} sizes="30vw" class="v-fondo" loading="lazy" />
                    <Picture src={img} alt={alt} formats={['avif', 'webp']} widths={[640, 960, 1200]} sizes="(min-width: 900px) 70vw, 100vw" class="v-foto" loading={k === 0 ? 'eager' : 'lazy'} />
                  </figure>
                );
              }) : (
                <figure class="v-slide v-sin" data-activa=""><Icono n="ola" tam={56} /><p>Todavía no tenemos foto de este cuarto.</p></figure>
              )}
            </div>
            <div class="v-info">
              <h3 class="serif">{t.nombre}</h3>
              <p class="v-cap"><Icono n="usuario" tam={18} /> Hasta {t.max_personas} personas, {t.cuartos} {t.cuartos === 1 ? 'cuarto' : 'cuartos'} en el hotel</p>
              {t.descripcion && <p class="v-desc">{t.descripcion}</p>}
              <ul class="v-inc">{incluye.map(([ic, tx]) => <li><Icono n={ic} tam={18} /><span>{tx}</span></li>)}</ul>
              <div class="v-pie">
                {t.desde_centavos != null && <p class="v-precio">Desde <strong class="serif num">{dinero(t.desde_centavos)}</strong> la noche</p>}
                <a class="btn btn-blanco" href="#reservar" data-reservar={t.id} data-nombre={t.nombre}><span>Reservar este cuarto</span><Icono n="flecha" tam={18} /></a>
              </div>
            </div>
          </template>
        </li>
      );
    })}
  </ul>
  <p class="nota">Las fotos son de cuartos del hotel y pueden no ser exactamente el tipo que reservas.</p>

  <dialog class="visor" data-dlg aria-label="Fotos del cuarto" aria-modal="true">
    <div class="v-fondo-cap" aria-hidden="true"></div>
    <div class="v-escena" data-escena></div>
    <ol class="v-barras" data-barras aria-hidden="true"></ol>
    <button type="button" class="v-cerrar vidrio" data-cerrar aria-label="Cerrar"><Icono n="cerrar" tam={22} /></button>
    <button type="button" class="v-flecha v-izq vidrio" data-prev aria-label="Foto anterior"><Icono n="izq" tam={22} /></button>
    <button type="button" class="v-flecha v-der vidrio" data-next aria-label="Foto siguiente"><Icono n="der" tam={22} /></button>
    <div class="v-panel vidrio" data-panel></div>
    <p class="visually-hidden" aria-live="polite" data-anuncio></p>
  </dialog>
</section>
