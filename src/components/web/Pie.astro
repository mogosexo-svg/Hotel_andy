---
import { waUrl, type Catalogo } from './catalogo';
interface Props { c: Catalogo; cierre?: boolean }
const { c, cierre = true } = Astro.props;
const tel = c.hotel.telefono;
---
<footer class="pie">
  {cierre && (
    <div class="container pie-cierre">
      <h2>Reserva directo con el hotel</h2>
      <div class="acciones">
        <a class="btn" href="#reservar">Reservar</a>
        <a class="btn btn-claro" href={waUrl(c, `Hola, quiero información para reservar en ${c.hotel.nombre}.`)} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>
  )}
  <div class="container pie-base">
    <p><strong>{c.hotel.nombre}</strong><br />{c.hotel.ciudad}, {c.hotel.provincia}, Ecuador</p>
    <p><a href={`tel:${tel.replace(/[^\d+]/g, '')}`} class="num">{tel}</a></p>
    <p><a href="/privacidad">Aviso de privacidad</a></p>
    <p class="nota">© 2026 {c.hotel.nombre}. Web de Mogolicous.</p>
  </div>
</footer>
