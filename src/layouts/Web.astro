---
import '@fontsource-variable/funnel-display';
import '@fontsource-variable/funnel-sans';
import '../styles/web.css';
import { cargarCatalogo, waUrl } from '../components/web/catalogo';

interface Props { title: string; description: string; og?: string; jsonld?: object[] }
const { title, description, og, jsonld = [] } = Astro.props;
const c = await cargarCatalogo();
const canonical = new URL(Astro.url.pathname, Astro.site);
const wa = waUrl(c, `Hola, quiero información para reservar en ${c.hotel.nombre}.`);
---
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f4f66" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={c.hotel.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <slot />
    <a class="wa-flotante" href={wa} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor"><path d="M5 3h14a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-8l-5 4v-4H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z"/></svg>
      <span>WhatsApp</span>
    </a>
    <script>
      import '../components/web/web';
    </script>
  </body>
</html>
