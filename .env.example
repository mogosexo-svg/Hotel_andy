PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Reseñas de Google en la web (solo en build; nunca llegan al navegador). Vacías: la sección muestra solo la nota de Booking.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Zernio (WhatsApp y redes por API oficial). Solo servidor/scripts: nunca en variables PUBLIC_.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
# Opcionales para `pnpm zernio:setup`: a dónde vuelve el navegador tras conectar, y "api" para WhatsApp sin coexistencia con la app.
ZERNIO_REDIRECT_URL=
ZERNIO_ONBOARDING=
